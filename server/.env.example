NODE_ENV=development
PORT=3105
MONGO_URI=mongodb://127.0.0.1:27017/madar
MONGO_URI_TEST=mongodb://127.0.0.1:27017/madar_test
JWT_ACCESS_SECRET=change-me-to-32-plus-random-characters-aaaa
JWT_REFRESH_SECRET=change-me-to-32-plus-random-characters-bbbb
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
# مفصولة بفواصل
ALLOWED_ORIGINS=http://localhost:5173
# false عند التقديم عبر HTTP بلا TLS (كما على IP مباشر)
COOKIE_SECURE=false
# مسار ملفات الواجهة المبنية (يُقدَّم عندما يكون موجوداً)
CLIENT_DIST=../client/dist
APP_URL=http://localhost:3105
# بريد الأدمن (مفصول بفواصل): يُمنح دور admin عند التسجيل/الدخول
ADMIN_EMAILS=
# مفاتيح Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# تصحيح الأسئلة المفتوحة بالذكاء الاصطناعي (اختياري؛ بدونه يُستخدم تصحيح تقريبي)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# دخول Google (اختياري؛ الزر يظهر فقط عند ضبطهما). Redirect URI: {APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TZ=Asia/Riyadh
